# ==============================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT - GETRAW® STREETWEAR
# Salin file ini menjadi `.env` dan sesuaikan dengan konfigurasi sistem Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (VITE)
# ------------------------------------------------------------------------------
# Opsi A: Mengarah ke Apache XAMPP (Port 80)
VITE_API_BASE_URL=http://localhost/api/v1
VITE_UPLOADS_BASE_URL=http://localhost/uploads

# Opsi B: Mengarah ke subfolder di htdocs XAMPP (jika project diletakkan di htdocs/getraw.ftp)
# VITE_API_BASE_URL=http://localhost/getraw.ftp/api/v1
# VITE_UPLOADS_BASE_URL=http://localhost/getraw.ftp/uploads

# Opsi C: Mengarah ke Express Backend langsung (Port 5001)
# VITE_API_BASE_URL=http://localhost:5001/api/v1
# VITE_UPLOADS_BASE_URL=http://localhost:5001/uploads

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (NODE.JS / EXPRESS)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
JWT_SECRET=your_secret_jwt_key_here
APP_URL=http://localhost
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (XAMPP MYSQL / PHPMYADMIN)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=getraw_db
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 4. PATH XAMPP LOKAL (MACOS)
# ------------------------------------------------------------------------------
XAMPP_PATH=/Applications/XAMPP/xamppfiles
XAMPP_HTDOCS_PATH=/Applications/XAMPP/xamppfiles/htdocs
